# ---- Database ----
DB_URL=jdbc:mysql://localhost:3306/vuatho?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Ho_Chi_Minh
DB_USERNAME=root
DB_PASSWORD=

# ---- JWT (bắt buộc) - chuỗi base64 giải mã ra >= 32 byte, ví dụ: openssl rand -base64 48 ----
JWT_SECRET=
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7

# ---- Tài khoản admin tự tạo khi khởi động (bắt buộc đặt ADMIN_PASSWORD) ----
ADMIN_EMAIL=admin@vuatho.com
ADMIN_PASSWORD=
ADMIN_PHONE=0900000000

# ---- Dịch vụ ngoài ----
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
GOONG_API_KEY=            # khóa REST của Goong (backend)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GEMINI_FALLBACK_MODELS=

# ---- Redis (vị trí thợ phục vụ ghép thợ) ----
REDIS_HOST=localhost
REDIS_PORT=6379

# ---- Khác ----
SERVER_PORT=8080
